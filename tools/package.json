{
  "name": "poyodash-tools",
  "private": true,
  "description": "Builds assets/bindings.iife.js (the SpacetimeDB connection code the game loads).",
  "scripts": {
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb",
    "bindings": "esbuild src/game-bundle.ts --bundle --format=iife --minify --outfile=../assets/bindings.iife.js"
  },
  "dependencies": {
    "spacetimedb": "^2.14.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
